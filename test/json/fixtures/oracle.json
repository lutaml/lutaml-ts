  "cases": [
    {
      "id": "rec-empty-object",
      "model_id": "OracleModels::Rec@default",
      "input": "{}",
      "expected_output": "{\"nn\":null,\"ne\":\"\",\"nl\":[]}",
      "ruby_class": "OracleModels::Rec"
    },
    {
      "id": "rec-scalars",
      "model_id": "OracleModels::Rec@default",
      "input": "{\"label\":\"L\",\"flag\":true,\"plain\":\"p\"}",
      "expected_output": "{\"label\":\"L\",\"flag\":true,\"nn\":null,\"ne\":\"\",\"nl\":[],\"plain\":\"p\"}",
      "ruby_class": "OracleModels::Rec"
    },
    {
      "id": "rec-flag-false",
      "model_id": "OracleModels::Rec@default",
      "input": "{\"flag\":false}",
      "expected_output": "{\"flag\":false,\"nn\":null,\"ne\":\"\",\"nl\":[]}",
      "ruby_class": "OracleModels::Rec"
    },
    {
      "id": "rec-alias-first",
      "model_id": "OracleModels::Rec@default",
      "input": "{\"lbl\":\"via lbl\"}",
      "expected_output": "{\"label\":\"via lbl\",\"nn\":null,\"ne\":\"\",\"nl\":[]}",
      "ruby_class": "OracleModels::Rec"
    },
    {
      "id": "rec-alias-third",
