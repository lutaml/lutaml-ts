      "model_id": "OracleModels::Rec@default",
      "input": "{\"child\":{\"name\":\"c\"},\"kids\":[{\"name\":\"k1\"},{\"name\":\"k2\"}]}",
      "expected_output": "{\"child\":{\"name\":\"c\"},\"kids\":[{\"name\":\"k1\"},{\"name\":\"k2\"}],\"nn\":null,\"ne\":\"\",\"nl\":[]}",
      "ruby_class": "OracleModels::Rec"
