      "input": "{\"plain\":\"z\",\"flag\":true,\"label\":\"a\"}",
      "expected_output": "{\"label\":\"a\",\"flag\":true,\"nn\":null,\"ne\":\"\",\"nl\":[],\"plain\":\"z\"}",
      "ruby_class": "OracleModels::Rec"
    },
